# ==============================================================================
# 苍穹外卖 (Sky Take Out) 环境变量配置模板
# 使用方式：复制此文件为 .env 或直接在 IDE / 系统环境中配置以下环境变量
# ==============================================================================

# 1. 数据库与 Redis 密码
# 对应 application-dev.yml 中的 ${PASSWORD}
PASSWORD=123456

# 2. 阿里云 OSS 对象存储配置 (用于菜品/套餐图片上传)
# 对应 application-dev.yml 中的 ${OSS_ACCESS_KEY_ID} 与 ${OSS_ACCESS_KEY_SECRET}
OSS_ACCESS_KEY_ID=your_aliyun_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_aliyun_oss_access_key_secret

# 3. 微信小程序配置 (用于用户端授权登录)
# 对应 application-dev.yml 中的 ${WECHAT_APP_ID} 与 ${WECHAT_SECRET}
WECHAT_APP_ID=your_wechat_miniprogram_app_id
WECHAT_SECRET=your_wechat_miniprogram_app_secret
